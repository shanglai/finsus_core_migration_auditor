{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/content/**",
              "components/core/**",
              "components/layout/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|direction|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArrowButton> doesn't accept that prop. Declared props: variant, size, direction, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|dark|outline)$/]",
        "message": "<ArrowButton> variant must be one of 'primary' | 'dark' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowButton'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:right|left|up|down)$/]",
        "message": "<ArrowButton> direction must be one of 'right' | 'left' | 'up' | 'down'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|href|tone|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArrowLink> doesn't accept that prop. Declared props: children, href, tone, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrowLink'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|ink)$/]",
        "message": "<ArrowLink> tone must be one of 'brand' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|withArrow|disabled|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, withArrow, disabled, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|dark|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'dark' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:m|l)$/]",
        "message": "<Button> size must be one of 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|imageSrc|bullets|linkLabel|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<CaseCard> doesn't accept that prop. Declared props: title, imageSrc, bullets, linkLabel, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|ink|soft|outline)$/]",
        "message": "<Chip> tone must be one of 'brand' | 'ink' | 'soft' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:s|m)$/]",
        "message": "<Chip> size must be one of 's' | 'm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:markSrc|tagline|columns|contactHeading|contactBody|contactCtaLabel|onContact|legal|legalLinks|onNavigate|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: markSrc, tagline, columns, contactHeading, contactBody, contactCtaLabel, onContact, legal, legalLinks, onNavigate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IndustryCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|description|iconSrc|style|key|ref|className|style|children)$/]",
        "message": "<IndustryCard> doesn't accept that prop. Declared props: name, description, iconSrc, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='LangToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|options|style|key|ref|className|style|children)$/]",
        "message": "<LangToggle> doesn't accept that prop. Declared props: value, onChange, options, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|links|activeHref|lang|onLangChange|ctaLabel|onCta|onNavigate|floating|translucent|style|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: logoSrc, links, activeHref, lang, onLangChange, ctaLabel, onCta, onNavigate, floating, translucent, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PartnerTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|logoSrc|selected|onClick|style|key|ref|className|style|children)$/]",
        "message": "<PartnerTile> doesn't accept that prop. Declared props: name, logoSrc, selected, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='RingMotif'] > JSXAttribute > JSXIdentifier[name!=/^(?:columns|rows|size|gap|color|accentColor|accentIndex|strokeWidth|style|key|ref|className|style|children)$/]",
        "message": "<RingMotif> doesn't accept that prop. Declared props: columns, rows, size, gap, color, accentColor, accentIndex, strokeWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|title|body|align|size|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: eyebrow, title, body, align, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:m|l)$/]",
        "message": "<SectionHeading> size must be one of 'm' | 'l'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SolutionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|iconSrc|description|href|onClick|style|key|ref|className|style|children)$/]",
        "message": "<SolutionCard> doesn't accept that prop. Declared props: title, iconSrc, description, href, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatBlock> doesn't accept that prop. Declared props: value, label, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:brand|ink)$/]",
        "message": "<StatBlock> tone must be one of 'brand' | 'ink'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<StatBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:year|body|mediaSrc|mediaSlot|style|key|ref|className|style|children)$/]",
        "message": "<TimelineCard> doesn't accept that prop. Declared props: year, body, mediaSrc, mediaSlot, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
